# Supabase > Connect: Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase > Settings > API Keys > Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Optional: narrative explanations. Server-only; never prefix these with NEXT_PUBLIC.
OPENAI_API_KEY=
OPENAI_MODEL=

# Asaas Sandbox — exclusively server-side
ASAAS_ENV=sandbox
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Independent random secret, at least 32 characters; same authToken in Asaas webhook
ASAAS_WEBHOOK_TOKEN=
# Supabase secret key (or SUPABASE_SERVICE_ROLE_KEY); never NEXT_PUBLIC
SUPABASE_SECRET_KEY=
# Public origin for checkout return URLs
STUDIFY_APP_URL=http://localhost:3000
# Operational notification address required by the webhook setup script
ASAAS_WEBHOOK_EMAIL=
